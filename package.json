{
  "name": "mer-harness",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.33.4",
  "scripts": {
    "dev": "pnpm build && concurrently -k 'wrangler dev --env development --local --port 8787' 'pnpm --filter @mer/web dev'",
    "build": "pnpm --filter @mer/web build && node scripts/build-sw.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "db:migrate:local": "wrangler d1 migrations apply mer-harness-dev --env development --local",
    "deploy:staging": "pnpm build && wrangler deploy --env staging",
    "test:e2e": "playwright test",
    "db:migrate:staging": "wrangler d1 migrations apply mer-harness-stg --env staging --remote",
    "shots": "playwright test --config playwright.shots.config.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.0",
    "@cloudflare/workers-types": "^5.20261002.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.4.0",
    "concurrently": "^9.1.0",
    "miniflare": "5.20261001.0-alpha",
    "typescript": "^5.8.0",
    "vite": "^6.3.0",
    "vitest": "^3.2.0",
    "wrangler": "^4.40.0"
  },
  "dependencies": {
    "@mer/core": "workspace:*",
    "hono": "^4.9.0",
    "jose": "^6.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.0"
  },
  "engines": {
    "node": ">=22"
  }
}
